# ===== Base de datos MySQL =====
# Crear antes la base: CREATE DATABASE academia_db;
DB_HOST=localhost
DB_PORT=3306
DB_NAME=academia_db
DB_USERNAME=root
# Contraseña de tu MySQL local (dejar vacía si no tiene)
DB_PASSWORD=

# ===== Autenticación JWT =====
# Genera una clave aleatoria Base64 de al menos 32 bytes y no la compartas.
APP_JWT_SECRET=REEMPLAZAR_POR_UNA_CLAVE_BASE64_SEGURA

# ===== Servidores =====
# Puerto donde corre el backend (Spring Boot)
BACKEND_PORT=8080
# Puerto del frontend (Vite); el backend lo usará para permitir CORS
FRONTEND_PORT=5173
