# ===== Base de datos MySQL =====
# Crear antes la base: CREATE DATABASE academia_db;
DB_HOST=localhost
DB_PORT=3306
DB_NAME=academia_db
DB_USERNAME=root
# Contraseña de tu MySQL local (dejar vacía si no tiene)
DB_PASSWORD=

# ===== Autenticación JWT =====
# Genera una clave aleatoria Base64 de al menos 32 bytes y no la compartas.
APP_JWT_SECRET=REEMPLAZAR_POR_UNA_CLAVE_BASE64_SEGURA

# ===== Archivos subidos =====
# Carpeta donde se guardan los comprobantes (relativa a backend/ o absoluta). Opcional.
# STORAGE_PATH=./uploads

# ===== Servidores =====
# Puerto donde corre el backend (Spring Boot)
BACKEND_PORT=8080
# Origen permitido para llamadas desde el frontend
FRONTEND_ORIGIN=http://localhost:5173
